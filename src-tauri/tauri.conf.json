{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamWave",
  "version": "0.9.0",
  "identifier": "com.del.streamwave",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StreamWave",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Del (postmanpat)",
    "shortDescription": "Audio recorder & editor for streamers, with OBS sync",
    "homepage": "https://github.com/postmanpat-303/StreamWave",
    "license": "MIT",
    "category": "Music",
    "copyright": "© 2026 Del (postmanpat), MIT licence",
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ],
        "recommends": [
          "ffmpeg"
        ],
        "section": "sound"
      },
      "rpm": {
        "depends": [
          "libasound.so.2()(64bit)"
        ],
        "recommends": [
          "/usr/bin/ffmpeg"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "twt"
        ],
        "name": "StreamWave Project",
        "description": "StreamWave audio project",
        "role": "Editor",
        "mimeType": "application/x-streamwave-project"
      }
    ]
  },
  "mainBinaryName": "StreamWave",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwNjBDOTUzN0E3OENBMkMKUldRc3luaDZVOGxnOE5jWjBFdTNpaGVIb0M3elEwZXNGSDhGUzd5Nnh0c1VrZDVSaEgrS1FrU1kK",
      "endpoints": [
        "https://github.com/postmanpat-303/StreamWave/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
