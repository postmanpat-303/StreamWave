{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamWave",
  "version": "0.5.2",
  "identifier": "com.del.streamwave",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StreamWave",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Derek Heasley",
    "shortDescription": "Audio recorder & editor for streamers, with OBS sync",
    "homepage": "https://github.com/postmanpat-303/StreamWave",
    "license": "MIT",
    "category": "Music",
    "copyright": "\u00a9 2026 Derek Heasley, MIT licence"
  },
  "mainBinaryName": "StreamWave"
}